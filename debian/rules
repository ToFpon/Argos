#!/usr/bin/make -f
# Application en Python sans module installé dans site-packages : le code va dans
# /usr/share/argos-viewer (privé), dh_python3 le compile à l'installation (py3compile).
# Paquet « argos-viewer » : Debian forky a déjà un paquet « argos » (client GTK de Mopidy).

%:
	dh $@ --with python3

override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	install -d debian/argos-viewer/usr/share/argos-viewer
	cp -r argos data debian/argos-viewer/usr/share/argos-viewer/
	find debian/argos-viewer/usr/share/argos-viewer -name __pycache__ -type d -prune -exec rm -rf {} +
	rm -f debian/argos-viewer/usr/share/argos-viewer/data/locale/*.pot

override_dh_python3:
	dh_python3 /usr/share/argos-viewer
